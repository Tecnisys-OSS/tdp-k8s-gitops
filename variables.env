# TDP GitOps Variables
# These variables are used to parameterize the ArgoCD Application manifests

# Core namespace and project variables
ARGOCD_NAMESPACE=argocd
TDP_NAMESPACE=tdp-ingestion
TDP_PROJECT_NAMESPACE=tdp-project
TDP_APPLICATIONS=argo-gitops-tdp-ingestion

# Git repository variables
GIT_REPO_URL=https://github.com/tdp-project/tdp-ingestion.git
GIT_REPO_USER=your-git-username
GIT_REPO_TOKEN_OR_PASS=your-git-token-or-password

# Helm chart repository
HELM_CHART_REPO_URL=registry.tecnisys.com.br/tdp/charts
HELM_CHART_VERSION=3.0.2

# Target cluster
KUBERNETES_SERVER=https://kubernetes.default.svc

# Domain for Ingress/Gateway API hostnames: <component>.${TDP_DOMAIN}
# (e.g. airflow.tdp.local). Overridden by deploy.sh -d/--domain.
TDP_DOMAIN=tdp.local

# IngressClass / StorageClass written into each component's values-gitops.yaml.
# Leave empty to use the chart default and the cluster's default class.
TDP_INGRESS_CLASS=
TDP_STORAGE_CLASS=

# How components with a web endpoint are exposed: ingress, gatewayapi or none
# (default none). Overridden by deploy.sh -e/--expose. With gatewayapi, the
# HTTPRoutes attach to an existing Gateway: set its name (and namespace, when it
# is not TDP_NAMESPACE).
TDP_EXPOSE=none
TDP_GATEWAY_NAME=
TDP_GATEWAY_NAMESPACE=

# OpenMetadata's metadata database: mysql (bundled, default) or postgresql (the
# tdp-postgresql component of this kit, release tdp-postgresql in TDP_NAMESPACE;
# deploy it first). Sets global.TDP-Settings.database in its values-gitops.yaml.
TDP_OPENMETADATA_DATABASE=mysql

# License. ArgoCD (tdp-argo) and every TDP component refuse to install unless
# tdp-license-operator runs and the license is VALID, so deploy.sh --install
# installs it first (deploy.sh --license installs or renews only the license).
# Both files come from Tecnisys; relative paths are relative to this file.
#   TDP_LICENSE_PUBLIC_KEYS_FILE  trusted public keys: {"<key_id>": "<base64 key>"}
#   TDP_LICENSE_FILE              signed lease: lease.json, or the lease Secret manifest
TDP_LICENSE_NAMESPACE=tdp-system
TDP_LICENSE_PUBLIC_KEYS_FILE=license/keys.json
TDP_LICENSE_FILE=license/lease.json
# Namespaces whose licensed workloads the license governs (comma-separated).
# Empty means TDP_NAMESPACE.
TDP_LICENSE_POLICY_NAMESPACES=

# Registry credentials (registry.tecnisys.com.br). Used for the Helm charts
# (ArgoCD repository secret) and for the images: deploy.sh creates the
# tdp-registry pull secret in TDP_NAMESPACE with them.
# This file is sourced by bash: single-quote values containing '$', such as
# Harbor robot accounts (TECNISYS_HELM_REGISTRY_USER='robot$tdp+pull').
TECNISYS_HELM_REGISTRY_USER=username@tecnisys.com.br
TECNISYS_HELM_REGISTRY_TOKEN=harbor_token

# Component passwords: UI admin logins and the database users whose password is
# set in values (the charts generate every other database password at random).
# deploy.sh writes them into current/<component>/values*.yaml, which is committed
# to the GitOps repository: keep that repository private.
# An empty entry uses TDP_DEFAULT_PASSWORD. Single-quote the values. Use at least
# 8 characters from A-Z a-z 0-9 ! . _ ~ - (the values are written unescaped into
# YAML, XML, shell, SQL and database URIs).
# They only take effect when a user is first created: changing one later does
# not change an existing user's password.
TDP_DEFAULT_PASSWORD='ChangeMe!T3c'
TDP_AIRFLOW_ADMIN_PASSWORD=            # Airflow UI user "admin"
TDP_AIRFLOW_DB_PASSWORD=               # Airflow built-in PostgreSQL (user postgres)
TDP_CLICKHOUSE_TRINO_PASSWORD=         # ClickHouse user "trino" (tdp-trino clickhouse catalog)
TDP_CLICKHOUSE_SUPERSET_PASSWORD=      # ClickHouse user "superset" (tdp-superset datasource)
TDP_CLOUDBEAVER_ADMIN_PASSWORD=        # CloudBeaver UI user "cbadmin"
TDP_HIVE_DB_PASSWORD=                  # Hive Metastore built-in PostgreSQL (user hive)
TDP_JUPYTER_ADMIN_PASSWORD=            # JupyterHub DummyAuthenticator password
TDP_KAFKA_UI_ADMIN_PASSWORD=           # Kafka UI user "admin" (LOGIN_FORM)
TDP_RANGER_ADMIN_PASSWORD=             # Ranger UI user "admin"
TDP_RANGER_DB_PASSWORD=                # Ranger database user "ranger"
TDP_SUPERSET_ADMIN_PASSWORD=           # Superset UI user "admin"
TDP_SUPERSET_DB_PASSWORD=              # Superset built-in PostgreSQL (users superset and postgres)

# Superset SECRET_KEY (signs sessions, encrypts stored connection passwords).
# Empty: deploy.sh keeps the key already rendered in current/, or generates one
# on the first render. Set it to pin the key, e.g. TDP_SUPERSET_SECRET_KEY='<openssl rand -base64 42>'.
TDP_SUPERSET_SECRET_KEY=

# Ozone security: Kerberos (Ozone's internal KDC) and real S3 authentication on
# Ozone's S3 Gateway. Off by default. Turn it on with enable-ozone-security.sh,
# which sets TDP_OZONE_SECURITY=true and renders each component's
# values-ozone-security.yaml (README: "Ozone security"). Once on, it cannot be
# turned off.
TDP_OZONE_SECURITY=false
# KDC master password, used once to create the KDC database. Same handling as
# TDP_SUPERSET_SECRET_KEY: empty keeps the one already rendered in current/, or
# generates one.
TDP_OZONE_KDC_MASTER_PASSWORD=
